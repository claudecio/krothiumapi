# =================== CONEXÃO BASE ===================
# Use este bloco quando existir apenas um banco principal.
# As chaves com prefixo da conexão continuam tendo prioridade sobre estas.
DB_DRIVER=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=meu_banco
DB_USERNAME=postgres
DB_PASSWORD=senha123
DB_CHARSET=UTF8
DB_PERSISTENT=false
DB_CONNECT_TIMEOUT=5
DB_TIMEZONE=UTC
DB_APPLICATION_NAME=KrothiumAPI

# Configurações específicas PostgreSQL
DB_SCHEMA=public
DB_SSLMODE=prefer # disable, allow, prefer, require, verify-ca, verify-full
# DB_SSLROOTCERT=/caminho/para/root.crt
# DB_SSLCERT=/caminho/para/client.crt
# DB_SSLKEY=/caminho/para/client.key

# =================== CONEXÃO POSTGRESQL (PGSQL) ===================
PGSQL_DB_DRIVER=pgsql
PGSQL_DB_HOST=127.0.0.1
PGSQL_DB_PORT=5432
PGSQL_DB_NAME=meu_banco_pg
PGSQL_DB_USERNAME=postgres
PGSQL_DB_PASSWORD=senha123
PGSQL_DB_PERSISTENT=false
PGSQL_DB_SCHEMA=public
PGSQL_DB_TIMEZONE=UTC
PGSQL_DB_SSLMODE=prefer
PGSQL_DB_CONNECT_TIMEOUT=5
PGSQL_DB_APPLICATION_NAME=KrothiumAPI_PG

# =================== CONEXÃO MYSQL ===================
MYSQL_DB_DRIVER=mysql
MYSQL_DB_HOST=127.0.0.1
MYSQL_DB_PORT=3306
MYSQL_DB_NAME=meu_banco_mysql
MYSQL_DB_USERNAME=root
MYSQL_DB_PASSWORD=senha123
MYSQL_DB_CHARSET=utf8mb4
MYSQL_DB_PERSISTENT=false
MYSQL_DB_CONNECT_TIMEOUT=5
MYSQL_DB_TIMEZONE=+00:00

# =================== CONEXÃO SQLITE (TESTES / EMBARCADOS) ===================
SQLITE_DB_DRIVER=sqlite
SQLITE_DB_NAME=:memory:
# SQLITE_DB_NAME=storage/database.sqlite
SQLITE_DB_FOREIGN_KEYS=true
SQLITE_DB_BUSY_TIMEOUT=5000
SQLITE_DB_JOURNAL_MODE=WAL

# =================== REDIS DEFAULT ===================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# =================== REDIS CACHE (opcional) ===================
REDIS_CACHE_HOST=127.0.0.1
REDIS_CACHE_PORT=6379
REDIS_CACHE_PASSWORD=
REDIS_CACHE_DATABASE=1